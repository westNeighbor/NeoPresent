    "mermaid": "^11.12.0",
    "neo.mjs": "^13.1.0",
    "pdfjs-dist": "^5.5.207"
  },
  "devDependencies": {
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0"
  }
